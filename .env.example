# ============================================================
# 广东省博物馆讲解 AI 后端 环境变量样例
# 复制为 .env 后填入真实值；密钥绝不能提交进仓库/镜像。
# ============================================================

# ── LLM（main.py 读取）────────────────────────────────
DEEPSEEK_KEY=

# ── Neo4j（museum_graph 读取；不设则用本地开发默认值）───
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── CORS（main.py 读取，逗号分隔多个来源）──────────────
# 留空或 * 表示放行所有来源；注意 allow_credentials 在 * 时自动关闭
CORS_ORIGINS=*

# ── RAG 向量检索（museum_rag.config 读取）───────────────
# 默认从 RAG/.env 读取；也可通过本文件注入（load_dotenv 会写入进程环境）
# DashScope 嵌入服务
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_WORKSPACE_ID=
# Qdrant：local=本地文件库（默认 RAG/data/qdrant）；server=远端托管
# 注意：docker compose 会把 QDRANT_MODE/QDRANT_URL 强制覆盖为 server/qdrant 容器地址
QDRANT_MODE=local
QDRANT_PATH=./RAG/data/qdrant
QDRANT_URL=http://localhost:6333

# ── 生产防护（main.py 读取）────────────────────────────
# /chat 接口按客户端 IP 滑动窗口限流：窗口内最多 N 次请求。
# 注意：内存版限流按 Gunicorn worker 各自计数，4 worker 下实际容量 ≈ 4×N。
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
# 仅当后端位于可信反代/负载均衡之后才置 1（届时按 X-Forwarded-For 首个地址限流）。
# 单机直连部署必须保持 0/留空：否则 X-Forwarded-For 可被客户端伪造而绕过限流。
TRUST_PROXY_XFF=0

# ── 访问鉴权（main.py 读取）────────────────────────────
# 逗号分隔的共享访问密钥。留空则 /chat 不鉴权（仅限本地开发/测试）。
# 生产环境务必设置：届时 /chat 要求请求头 X-API-Key 匹配其中之一，否则返回 401。
# 防止未授权第三方消耗 DeepSeek/DashScope 付费 token。
API_ACCESS_KEYS=
